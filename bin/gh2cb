#!/usr/bin/env bash

set -e

repos=(
    dotfiles
    notes
    picker.nvim
    quickfix.nvim
    wordiff.nvim
    silence.nvim
    term.nvim
    git.nvim
    jsonschema
)

if [ $# != 0 ]; then
    repos=("$@")
fi

eval "$(ssh-agent -s)"
trap 'ssh-agent -k' EXIT
ssh-add ~/.ssh/id_ed25519
echo

for repo in "${repos[@]}"; do
    echo "synching $repo..."
    if [ -d "$repo" ]; then
        cd "$repo"
        git fetch -p origin
    else
        git clone --bare "git@github.com:santhosh-tekuri/$repo.git" "$repo"
        cd "$repo"
        git remote set-url --push origin "git@codeberg.org:santhosh-tekuri/$repo.git"
    fi
    git push --mirror
    cd - >/dev/null
    echo
done

