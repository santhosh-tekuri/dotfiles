#!/usr/bin/env bash

set -e

colors_dim_foreground=$(tput setaf 0)
colors_status_line=$(tput setab 4 && tput setaf 7)
colors_session_name=$(tput setab 3 && tput setaf 0)

if [ -n "$ZMUX_BOOKMARKS" ]; then
    readarray -d ':' -t bookmarks <<< "$ZMUX_BOOKMARKS"
else
    bookmarks=(
        "$HOME"
        "$HOME/dotfiles"
        "$HOME/.config/nvim"
        ~/gh/santhosh-tekuri/*
    )
fi

# -------------------------------------------------------

if [ "$#" -ne 1 ]; then
    >&2 cat <<'EOF'
usage: zmux SESSION

tmux style session management for zmx
EOF
    exit 1
fi
session="$1"

if [ -n "$ZMX_SESSION" ]; then
    >&2 echo You are already in zmx session
    exit 1
fi

unset ZMX_SESSION_PREFIX
tab="$(printf '\t')"
awk_script=$(cat << 'EOF'
BEGIN { FS = OFS = "\t" }
{
    delete map;
    for (i=1; i<=NF; i++) {
        split($i, pair, "=")
        if (i==1) {
            pair[1] = "name" # to handle prefix in line
        }
        map[pair[1]] = pair[2]
    }
    if (!("index" in map)) {
        map["index"] = map["created"]
    }
    if (!("attached" in map)) {
        map["attached"] = map["created"]
    }
    print map["name"], map["session"], map["window"], map["index"], map["attached"]
}
EOF
)

function log() {
    true && echo "$1"
}

function pause() {
    read -rp "Press ENTER to continue..."
}

function zmx_ls() {
    zmx ls 2>/dev/null | awk "$awk_script"
}

function zmx_attach_existing() {
    tput cnorm
    name="$1"
    zmx set "$name" "attached=$(date +%s)"
    zmx attach "$name"
}

function prev() {
    t=$(echo -n "$windows" | grep -B1 "$name" | awk -F "$tab" 'NR==1 {print $1;exit}')
    if [ "$t" == "$name" ]; then
        t=$(echo -n "$windows" | awk -F "$tab" 'END {print $1}')
    fi
    echo -n "$t"
}

function next() {
    t=$(echo -n "$windows" | grep -A1 "$name" | awk -F "$tab" 'END {print $1}')
    if [ "$t" == "$name" ]; then
        t=$(echo -n "$windows" | awk -F "$tab" 'NR==1 {print $1;exit}')
    fi
    echo -n "$t"
}

trap "tput cnorm" EXIT

i=0
while true; do
    tput civis
    ((i++))
    all=$(zmx_ls)
    windows=$(echo -n "$all" | awk -F "$tab" -v "session=$session" '$2 == session')
    if [ $i -eq 1 ]; then
        if [ -z "$windows" ]; then
            log "session not exists"
            name="$(uuidgen)"
            window="default"
            for dir in "${bookmarks[@]}"; do
                if [ -d "$dir" ] && [ "$(basename "$dir")" == "$session" ]; then
                    cd "$dir"
                    break
                fi
            done
            tput cnorm
            zmx attach --labels "session=$session window=$window" "$name"
        else
            log "session exists"
            windows=$(echo -n "$windows" | sort "-t$tab" -k5nr)
            name=$(echo -n "$windows" | awk -F "$tab" 'NR=1 {print $1;exit}')
            window=$(echo -n "$windows" | awk -F "$tab" 'NR=1 {print $3;exit}')
            log "name is [$name]"
            zmx_attach_existing "$name"
        fi
        continue
    fi

    if [ -z "$windows" ]; then
        exit
    fi
    windows=$(echo -n "$windows" | sort "-t$tab" -k4n)

    echo -n "$colors_dim_foreground"
    zmx history "$name"
    # draw status bar --
    tput cup "$(tput lines)" 0
    echo -n "$colors_session_name"
    echo -n " $session "
    idx=0
    echo -n " "
    echo "$windows" | while read -r line; do
        ((idx++))
        win=$(echo -n "$line" | cut -f3)
        if [ "$(echo -n "$line" | cut -f1)" == "$name" ]; then
            tput sgr0 # active tab. reset colors
        else
            echo -n "$colors_status_line"
        fi
        echo -n " $idx:$win "
    done
    echo -n "$colors_status_line"
    tput el # erase line
    if [ -n "$SSH_CLIENT" ]; then
        ssh="${USER}@$(hostname) "
        tput cup "$(tput lines)" $(($(tput cols)-${#ssh}-1))
        echo -n "$ssh"
    fi
    tput sgr0 # reset colors
    tput home

    # echo "$all"
    # log "------------"
    # log "$windows"
    # log "------------"
    read -r -s -n 1 ch
    case "$ch" in
        "d")
            exit
            ;;
        "q")
            zmx_attach_existing "$name"
            ;;
        "c")
            read -rp "window name: " window
            name="$(uuidgen)"
            tput cnorm
            zmx attach --labels "session=$session window=$window" "$name"
            ;;
        [0-9])
            line=$(echo -n "$windows" | sed -n "${ch}p")
            if [ -n "$line" ]; then
                zmx_attach_existing "$(echo -n "$line" | cut -f1)"
            fi
            ;;
        "p")
            zmx_attach_existing "$(prev)"
            ;;
        "n")
            zmx_attach_existing "$(next)"
            ;;
        ",")
            read -rp "new window name: " resp
            if [ "$resp" != "" ]; then
                zmx set "$name" "window=$resp"
            fi
            zmx_attach_existing "$name"
            ;;
        "&")
            read -rs -n1 -p "kill current window? (y/n)" resp
            if [ "$resp" != "y" ] && [ "$resp" != "Y" ]; then
                zmx_attach_existing "$name"
                continue
            fi
            next="$(next)"
            if [ "$resp" == "y" ]; then
                zmx kill "$name"
            elif [ "$resp" == "Y" ]; then
                zmx kill --force "$name"
            fi
            if [ "$next" == "$name" ]; then
                exit
            else
                zmx_attach_existing "$next"
            fi
            ;;
        "s")
            read -rp "session: " resp
            if [ "$resp" != "" ]; then
                session="$resp"
                i=0
            else
                zmx_attach_existing "$name"
            fi
            ;;
    esac
done

