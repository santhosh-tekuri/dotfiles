#!/usr/bin/env bash

set -e

usage=$(cat << 'EOF'
zmux provides tmux style window & session management for zmx with prefix ctrl+\ 

usage: zmux <command> [args...]

commands:
    zmux attach
        attach to most recently used session
    zmux attach SESSION
        attach to SESSION
    zmux fzf
        pick session using fzf and attach
    zmux status [FIFO_FILE]
        - if FIFO_FILE arg missing, uses envar ZMUX_STATUS
        - typically used to render status always
          in bottom split of native terminal
        - creates FIFO_FILE using mkfifo
        - reads updates to status from it
        - and renders to screen bottom
        - deletes FIFO_FILE on exit
    zmux help
        show this help

environment variables:
    ZMUX_BOOKMARKS:
        - contains list of favourite projects separated by colon
        - can use wildcards
        - defaults to "~"
        - example: "~:~/dotfiles:~/.config/nvim:~/gh/santhosh-tekuri/*"
    ZMUX_CLR_DIM_TEXT
    ZMUX_CLR_STATUS
    ZMUX_CLR_SESSION_NAME
        - to customize colors used
        - example: "$(tput setab 4 && tput setaf 7)"
    ZMUX_STATUS
        - path to FIFO_FILE used for status line updates
        - if FIFO_FILE exists it does not render status
EOF
)
if [ $# == 0 ]; then
    >&2 echo "$usage"
    exit 1
elif [ "$1" == "help" ]; then
    echo "$usage"
    exit
fi

# read colors --

colors_dim_text="${ZMUX_CLR_DIM_TEXT:-$(tput setaf 8)}"
colors_status_line="${ZMUX_CLR_STATUS:-$(tput setab 4 && tput setaf 7)}"
colors_session_name="${ZMUX_CLR_SESSION_NAME:-$(tput setab 3 && tput setaf 0)}"

# read bookmarks --
bookmarks=()
IFS=: read -ra raw_patterns <<< "${ZMUX_BOOKMARKS:-~}"
shopt -s nullglob
for pat in "${raw_patterns[@]}"; do
  [[ -z "$pat" ]] && continue
  eval "pat=($pat)"
  bookmarks+=("${pat[@]}")
done
shopt -u nullglob

function log() {
    true && echo "$1"
}

function pause() {
    read -rp "Press ENTER to continue..."
}

if ! command -v zmx >/dev/null 2>&1; then
    >&2 echo missing zmx command in PATH
    exit 1
fi

if [ -n "$ZMX_SESSION" ]; then
    >&2 echo You are already in zmx session
    exit 1
fi

unset -v ZMX_SESSION_PREFIX
tab="$(printf '\t')"
awk_script=$(cat << 'EOF'
BEGIN { FS = OFS = "\t" }
{
    delete map;
    for (i=1; i<=NF; i++) {
        split($i, pair, "=")
        if (i==1) {
            pair[1] = "name" # to handle prefix in line
        }
        map[pair[1]] = pair[2]
    }
    if (!("index" in map)) {
        map["index"] = map["created"]
    }
    if (!("attached" in map)) {
        map["attached"] = map["created"]
    }
    print map["name"], map["session"], map["window"], map["index"], map["attached"], map["clients"], map["cwd"]
}
EOF
)

keybinds=$(cat << 'EOF'
    c       create new window
    C       new window with command
    ,       rename current window
    &       kill current window

[1-9]       select window at position
    n       select next window
    p       select prev window
    N       swap with next window
    P       swap with prev window
    l       select last visited window
    L       switch to last visited session

    $       rename session
    s       switch session
    d       detach client
    q       exit prefix mode
EOF
)
keybinds_lc=$(echo -n "$keybinds" | wc -l)
keybinds_width=$(echo -n "$keybinds" | wc -L)

function render_help() {
    row=$((($(tput lines)-keybinds_lc-1)/2))
    col=$((($(tput cols)-keybinds_width)/2))
    while IFS= read -r line || [[ -n "$line" ]]; do
        tput cup $row $col
        echo -n "$line"
        ((row++))
    done <<< "$keybinds"
}

function zmx_ls() {
    zmx ls 2>/dev/null | awk "$awk_script"
}

function ls_sessions() {
    echo -n "$all" \
        | awk '
          BEGIN { FS = OFS = "\t" }
          { clients[$2] += $6 }
          !($2 in attached) || ($5 > attached[$2]) { attached[$2] = $5 }
          END { for (k in clients) print k, clients[k], attached[k] }' \
        | sort "-t$tab" -k 2,2n -k 3,3nr \
        | awk -F "$tab" '{print $1}'
}

function prev() {
    t=$(echo -n "$windows" | grep -B1 "$name" | awk -F "$tab" 'NR==1 {print $1;exit}')
    if [ "$t" == "$name" ]; then
        t=$(echo -n "$windows" | awk -F "$tab" 'END {print $1}')
    fi
    echo -n "$t"
}

function next() {
    t=$(echo -n "$windows" | grep -A1 "$name" | awk -F "$tab" 'END {print $1}')
    if [ "$t" == "$name" ]; then
        t=$(echo -n "$windows" | awk -F "$tab" 'NR==1 {print $1;exit}')
    fi
    echo -n "$t"
}

function swap() {
    if [ "$1" != "$name" ]; then
        this_index=$(echo -n "$windows" | awk -F "$tab" -v "name=$name" '$1==name {print $4;exit}')
        that_index=$(echo -n "$windows" | awk -F "$tab" -v "name=$1" '$1==name {print $4;exit}')
        zmx set "$name" "index=$that_index"
        zmx set "$1" "index=$this_index"
    fi
}

function bell() {
    printf '\a'
}

function fifo_exists() {
    [ -n "$ZMUX_STATUS" ] && [ -p "$ZMUX_STATUS" ]
}

function prompt() {
    tput cup "$(tput lines)" 0
    if ! fifo_exists; then
        echo -n "$colors_status_line"
        tput el
    fi
    tput cnorm
    # shellcheck disable=SC2162
    read "$@"
    tput sgr0
    last="${!#}"
    test -n "${!last}"
}

function status_line() {
    echo -n "#$session"
    idx=0
    if [ -n "$windows" ]; then
        echo "$windows" | while IFS= read -r line; do
            ((idx++))
            win=$(echo -n "$line" | cut -f3)
            if [ "$(echo -n "$line" | cut -f1)" == "$name" ]; then
                echo -en $"\t*$idx:$win"
            else
                echo -en "\t $idx:$win"
            fi
        done
    fi
    if ! echo "$windows" | grep -q "$name"; then
        # about to create window
        idx=$(echo -n "$windows" | wc -l)
        ((idx++))
        echo -en $"\t*$idx:$window"
    fi
    if [ -n "$SSH_CLIENT" ]; then
        echo -en "\t@${USER}@$(hostname)"
    else
        echo -en "\t@"
    fi
    echo
}

function report_detach() {
    if fifo_exists; then
        echo "detach" > "$ZMUX_STATUS"
    fi
}

function report_status() {
    if fifo_exists; then
        status_line > "$ZMUX_STATUS"
    fi
}
function report_render_status() {
    local status_line
    status_line="$(status_line)"
    if fifo_exists; then
        echo "$status_line" > "$ZMUX_STATUS"
        tput home # to clear screen on detach
    else
        render_status "$status_line"
    fi
}

function render_status() {
    local -a arr
    IFS="$tab" read -r -a arr <<< "$1"
    for item in "${arr[@]}"; do
        str=$(echo -n "$item" | cut -c 2-)
        case "$(echo -n "$item" | cut -c 1)" in
            "#")
                tput cup "$(tput lines)" 0
                echo -n "$colors_session_name"
                echo -n " $str "
                ;;
            " ")
                echo -n "$colors_status_line"
                echo -n " $str "
                ;;
            "*")
                tput sgr0 # active tab. reset colors
                echo -n " $str "
                ;;
            "@")
                echo -n "$colors_status_line"
                tput el # erase line
                tput cup "$(tput lines)" $(($(tput cols)-${#str}))
                echo -n "$str "
                ;;
        esac
    done
    tput sgr0 # reset colors
    tput home
}

function zmx_attach_existing() {
    tput cnorm
    name="$1"
    zmx set "$name" "attached=$(date +%s)"
    report_status
    zmx attach "$name"
}

function pick_session() {
    ls_sessions=$(ls_sessions)
    if [ -n "$session" ]; then
        ls_sessions=$(echo -n "$ls_sessions" | grep -v "$session" | cat)
    fi
    input=$(
        if [ -n "$ls_sessions" ]; then
            echo "$ls_sessions"
        fi
        for dir in "${bookmarks[@]}"; do
            if [ -d "$dir" ]; then
                basename="$(basename "$dir")"
            fi
            if [ "$basename" != "$session" ] && ! echo -n "$ls_sessions" | grep -q "$basename"; then
                echo "$colors_dim_text$basename$(tput sgr0)"
            fi
        done
    )
    t=$(echo "$input" | fzf --bind 'ctrl-y:print-query' --ansi --layout=default --prompt "$1" || true)
    printf -v "${!#}" "%s" "$t"
    test -n "$t"
}

function dir_from_cwd() {
    local dir
    dir="/$(echo -n "$1" | cut -d'/' -f4-)"
    dir="${dir//+/ }" # replace '+' with ' '
    dir=$(printf '%b\n' "${dir//%/\\x}") # replace '%' with '\x' and printf with '%b' for backslash escape expansion
    echo -n "$dir"
}

if [ "$1" == "status" ]; then
    fifo_file="$ZMUX_STATUS"
    if [ $# == 2 ]; then
        fifo_file="$2"
    fi
    mkfifo "$fifo_file"
    trap 'rm "$fifo_file"; tput cnorm' EXIT
    clear
    tput civis
    while true; do
        while IFS= read -r line; do
            if [ "$line" == "detach" ]; then
                clear
            else
                render_status "$line"
            fi
        done < "$fifo_file"
    done
elif [ "$1" == "attach" ]; then
    session="$2"
elif [ "$1" == "fzf" ]; then
    all=$(zmx_ls)
    if ! command -v fzf >/dev/null; then
        >&2 echo missing fzf command in PATH
        exit 1
    elif ! pick_session " attach to session: " session; then
        exit
    fi
else
    >&2 echo "$usage"
    exit 1
fi

function cleanup() {
    report_detach
    tput cnorm
}
trap 'cleanup' EXIT

i=0
while true; do
    # handle current window no longer exists
    unset -v idx
    if [ "$i" -ne 0 ] && [ -n "$name" ]; then
        idx=$(echo -n "$windows" | awk -F "$tab" -v "name=$name" '$1==name {print NR;exit}')
        if [ -z "$idx" ]; then
            # killed window is recently created
            idx=$(($(echo -n "$windows" | wc -l)+1))
        fi
    fi

    tput civis
    ((i++))
    all=$(zmx_ls)
    if [ -z "$session" ]; then
        sessions=$(ls_sessions)
        session=$(echo -n "$sessions" | awk -F "$tab" 'NR==1 {print;exit}')
        if [ -z "$session" ]; then
            >&2 echo no sessions
            exit 1
        fi
    fi
    windows=$(echo -n "$all" | awk -F "$tab" -v "session=$session" '$2 == session' | sort "-t$tab" -k4n)

    # handle current window no longer exists
    if [ -n "$idx" ] && ! echo "$windows" | grep -q "$name"; then
        name=$(echo -n "$windows" | awk -F "$tab" -v "idx=$idx" 'NR==idx {print $1;exit}')
        if [ -z "$name" ]; then
            name=$(echo -n "$windows" | awk -F "$tab" 'END {print $1;exit}')
        fi
        if [ -z "$name" ]; then
            exit
        else
            zmx_attach_existing "$name"
            continue
        fi
    fi

    if [ $i -eq 1 ]; then
        if [ -z "$windows" ]; then
            name="$(uuidgen)"
            window="main"
            for dir in "${bookmarks[@]}"; do
                if [ -d "$dir" ] && [ "$(basename "$dir")" == "$session" ]; then
                    cd "$dir"
                    break
                fi
            done
            tput cnorm
            report_status
            zmx attach --labels "session=$session window=$window" "$name"
        else
            wins=$(echo -n "$windows" | sort "-t$tab" -k5nr)
            name=$(echo -n "$wins" | awk -F "$tab" 'NR=1 {print $1;exit}')
            window=$(echo -n "$wins" | awk -F "$tab" 'NR=1 {print $3;exit}')
            zmx_attach_existing "$name"
        fi
        continue
    fi

    if [ -z "$windows" ]; then
        exit
    fi
    # windows=$(echo -n "$windows" | sort "-t$tab" -k4n) # sort by index

    render_help
    report_render_status "$(status_line)"

    read -r -s -n 1 ch
    case "$ch" in
        "d")
            report_detach
            exit
            ;;
        "q")
            zmx_attach_existing "$name"
            ;;
        "c")
            cwd=$(echo -n "$windows" | awk -F "$tab" -v "name=$name" '$1==name {print $7;exit}')
            dir=$(dir_from_cwd "$cwd")
            if prompt -rep " create new window: " window; then
                name="$(uuidgen)"
                tput cnorm
                cd "$dir"
                report_status
                zmx attach --labels "session=$session window=$window" "$name"
            else
                zmx_attach_existing "$name"
            fi
            ;;
        "C")
            cwd=$(echo -n "$windows" | awk -F "$tab" -v "name=$name" '$1==name {print $7;exit}')
            dir=$(dir_from_cwd "$cwd")
            if prompt -rep " new window with command: " cmd; then
                window=$(echo -n "$cmd" | cut -d ' ' -f1)
                name="$(uuidgen)"
                tput cnorm
                cd "$dir"
                report_status
                zmx attach --labels "session=$session window=$window" "$name" $cmd
            else
                zmx_attach_existing "$name"
            fi
            ;;
        [0-9])
            line=$(echo -n "$windows" | sed -n "${ch}p")
            if [ -n "$line" ]; then
                zmx_attach_existing "$(echo -n "$line" | cut -f1)"
            else
                bell
            fi
            ;;
        "l")
            _windows="$windows"
            windows=$(echo -n "$windows" | sort "-t$tab" -k5nr)
            last="$(next)"
            windows="$_windows"
            report_status
            zmx_attach_existing "$last"
            ;;
        "L")
            ls_sessions=$(ls_sessions)
            if [ -n "$session" ]; then
                ls_sessions=$(echo -n "$ls_sessions" | grep -v "$session" | cat)
            fi
            s=$(echo -n "$ls_sessions" | awk 'NR==1 {print;exit}')
            if [ -n "$s" ]; then
                n=$(echo -n "$all" | awk -F "$tab" -v "session=$s" '$2==session {print $1;exit}')
                session="$s"
                all="$(zmx_ls)"
                windows=$(echo -n "$all" | awk -F "$tab" -v "session=$session" '$2 == session' | sort "-t$tab" -k4n)
                zmx_attach_existing "$n"
            else
                zmx_attach_existing "$name"
            fi
            ;;
        "p")
            zmx_attach_existing "$(prev)"
            ;;
        "n")
            zmx_attach_existing "$(next)"
            ;;
        "P")
            swap "$(prev)"
            ;;
        "N")
            swap "$(next)"
            ;;
        ",")
            if prompt -rep " rename window: " resp; then
                zmx set "$name" "window=$resp"
                all="$(zmx_ls)"
                windows=$(echo -n "$all" | awk -F "$tab" -v "session=$session" '$2 == session' | sort "-t$tab" -k4n)
            fi
            zmx_attach_existing "$name"
            ;;
        "$")
            if prompt -rep " rename session: " resp; then
                echo -n "$windows" | cut -f1 | while IFS= read -r line; do
                    zmx set "$line" "session=$resp"
                done
                session="$resp"
            fi
            zmx_attach_existing "$name"
            ;;
        "&")
            prompt -rs -n1 -p " kill current window? (y/n) (Y to force kill)" resp
            if [ "$resp" != "y" ] && [ "$resp" != "Y" ]; then
                zmx_attach_existing "$name"
                continue
            fi
            if [ "$resp" == "y" ]; then
                zmx kill "$name"
            elif [ "$resp" == "Y" ]; then
                zmx kill --force "$name"
            fi
            ;;
        "s")
            if command -v fzf >/dev/null; then
                pick_session " switch to session: " resp || true
            else
                prompt -rep " switch to session: " resp || true
            fi
            if [ -n "$resp" ]; then
                session="$resp"
                i=0
            else
                zmx_attach_existing "$name"
            fi
            ;;
    esac
done

